# Application Environment (development | staging | production)
APP_ENV=development

# Storage Configuration
# In production, set GCS_BUCKET_NAME to your Google Cloud Storage bucket
# In local development, leave GCS_LOCAL_MOCK_DIR set to use local directory emulation
GCS_BUCKET_NAME=drift-platform-data
GCS_LOG_PREFIX=inference_logs
GCS_LOCAL_MOCK_DIR=./data/gcs_mock
MODEL_REGISTRY_PATH=./data/models

# Web Service & Ingest API
WEB_API_URL=http://localhost:3000/api/drift/ingest
WEB_PORT=3000
SERVING_PORT=8000

# Security: HMAC secret shared between Drift Worker and Web API Ingest
DRIFT_HMAC_SECRET=generate-a-strong-32-byte-hex-secret-key-here

# Database Configuration (PostgreSQL / Neon Serverless)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/drift_platform
# For Neon in production:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/drift_platform?sslmode=require

# Telegram Notification Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# GitHub Actions Workflow Dispatch (for retraining trigger)
GITHUB_REPO=your-org/drift-platform
GITHUB_TOKEN=ghp_yourPersonalAccessTokenWithWorkflowScope

# Model Serving Service Configuration
SERVING_BUFFER_SIZE=200
SERVING_FLUSH_INTERVAL_SECONDS=15
SERVING_LOG_LEVEL=INFO
